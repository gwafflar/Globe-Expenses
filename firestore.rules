rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // users/{userId}
    // -------------------------------------------------------------------------
    // Any authenticated user can READ a profile (needed for nametag search and
    // friend display). Only the owner can WRITE their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // users/{userId}/friends/{friendId}
      // The friend list is private — only the owner can read it.
      // Writing rules are intentionally permissive in one direction:
      //   - The owner can write to their own list (normal case).
      //   - A third party can only write an entry WHERE the entry's uid == their own uid
      //     AND the document ID == their own uid. This allows the invite accepter to add
      //     themselves to the inviter's friend list as part of the batch write on accept.
      match /friends/{friendId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && (
            // Owner writes to their own list
            request.auth.uid == userId
            // OR: someone adds themselves to this user's list (invite acceptance)
            || (friendId == request.auth.uid
                && request.resource.data.uid == request.auth.uid)
          );
      }

      // NOTE: the `allow write` on users/{userId} above covers that ONE document
      // only. Rules do not cascade to subcollections, so each notification path
      // below needs its own match — without one, every client access is denied.
      // All of them are owner-only. The Cloud Functions write with the Admin SDK,
      // which bypasses these rules entirely. See docs/NOTIFICATIONS_SPEC.md §3.4.

      // users/{userId}/activity/{eventId} — the activity feed (§3.1).
      // Created only by Cloud Functions. The owner may read their feed and mark
      // an entry as read by setting `openedAt`, nothing else (no create/delete).
      match /activity/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openedAt'])
          && request.resource.data.openedAt is timestamp;
      }

      // users/{userId}/fcmTokens/{token} — one document per device (§2.1).
      // `update` is needed on top of the spec's create/delete: the client
      // re-registers its token on every app open, and re-writing an existing
      // document is an update.
      match /fcmTokens/{token} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      // users/{userId}/pushThrottle/{key} — push limiter counter (§6.1).
      // Counter logic lives in the Cloud Function; the client may only reset
      // `count` to 0 when the user opens a space. The client must write with
      // setDoc(ref, { count: 0 }, { merge: true }) so `lastEventAt` is untouched.
      match /pushThrottle/{key} {
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count == 0;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && request.resource.data.count == 0;
      }

      // users/{userId}/private/notifications — owner-only notification state
      // (§3.5). Lives here rather than on users/{userId}, which every signed-in
      // user can read. Only the three known fields may be stored.
      match /private/notifications {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(
               ['mutedSpaceIds', 'activityLastSeenAt', 'activityReadAllAt']);
      }
    }

    // -------------------------------------------------------------------------
    // nametags/{tag}
    // -------------------------------------------------------------------------
    // Sentinel collection for nametag uniqueness. Each document's ID is a lowercase
    // nametag handle, and it contains only { uid: string } — the owner's UID.
    //
    // Security model:
    //   - Read: any authenticated user (needed for availability checks)
    //   - Create: authenticated user claiming their own UID
    //   - Delete: only the owner (to release their handle)
    //   - Update: forbidden — handles are released and re-claimed via delete + create
    match /nametags/{tag} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // -------------------------------------------------------------------------
    // invites/{inviteId}
    // -------------------------------------------------------------------------
    // Invite documents are capability-gated: knowing the inviteId IS the
    // authorization to read it (the ID is an opaque random token, never guessable).
    //
    // Create: sender must set fromUid to their own UID.
    // Update (accept): requester must not already be in usedBy, and must be either
    //   the targeted recipient (toUid) or any authenticated user (multi-use link).
    //   fromUid cannot be changed (tamper protection).
    // Delete (revoke): only the sender.
    match /invites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.usedBy)
        && (resource.data.multiUse == true
            || resource.data.toUid == request.auth.uid)
        && request.resource.data.fromUid == resource.data.fromUid;
      allow delete: if request.auth != null
        && resource.data.fromUid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // travels/{travelId}
    // -------------------------------------------------------------------------
    match /travels/{travelId} {
      // Members can read and write freely.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      // Travel creation: creator must include themselves in memberUids.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids;

      // Non-member join via invite:
      // A user not yet in memberUids may update the travel IF the write carries a
      // pendingInviteId that references an active travel_member invite for this travel.
      //
      // Why we do NOT check request.resource.data.memberUids:
      //   Firestore FieldValue transforms (arrayUnion) are NOT reflected in
      //   request.resource.data during rule evaluation — the field still holds
      //   the pre-write value, causing size/inclusion checks to fail spuriously.
      //   Security is provided by the invite token (capability-based access):
      //     - The token is an opaque random ID known only to the sender
      //     - The invite must be 'active' (not revoked / expired)
      //     - The invite's travelId must match this travel document
      //     - The accepter must not already be a member (first check below)
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.memberUids)
        && 'pendingInviteId' in request.resource.data
        && get(/databases/$(database)/documents/invites/$(request.resource.data.pendingInviteId)).data.status == 'active'
        && get(/databases/$(database)/documents/invites/$(request.resource.data.pendingInviteId)).data.travelId == travelId;

      // travels/{travelId}/transactions/{txId}
      // Membership check is delegated to the parent travel document via get().
      // get() counts as one extra read per rule evaluation — acceptable for v1.
      match /transactions/{txId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/travels/$(travelId)).data.memberUids;
      }
    }

  }
}
