{
  "name": "globe-expenses-functions",
  "private": true,
  "description": "Cloud Functions for GlobeExpenses (notifications, activity feed, space cascade delete)",
  "main": "lib/index.js",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "pnpm build && firebase emulators:start --only auth,firestore,functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  }
}
